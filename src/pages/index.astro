---
import Layout from '~/layouts/Layout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Crushy Social — People first. Always.',
  ignoreTitleTemplate: true,
  description:
    'Crushy Social is a Vancouver company building social products that put people first. Our company site is coming soon.',
};

const appHref = getPermalink('/');
const year = new Date().getFullYear();
---

<Layout metadata={metadata}>
  <div class="holding">
    <div class="shell">
      <header class="rail">
        <span class="wordmark">Crushy Social</span>
        <span class="place">Vancouver, Canada</span>
      </header>

      <main class="stage">
        <p class="kicker reveal" style="--d: 0ms"><span class="tick" aria-hidden="true"></span>Coming soon</p>

        <h1 class="statement reveal" style="--d: 90ms">People first. Always.</h1>

        <p class="lede reveal" style="--d: 180ms">
          Crushy Social is a Vancouver company building social products that help people actually connect — no
          algorithms, no bots, no paywalls.
        </p>
      </main>

      <a class="handoff reveal" style="--d: 280ms" href={appHref}>
        <span class="handoff-text">
          <span class="handoff-label">Looking for the Crushy dating app?</span>
          <span class="handoff-action">
            Go to crushy.social/app
            <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M4 12h15m0 0-6-6m6 6-6 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </span>
      </a>

      <footer class="foot">
        <span>&copy; {year} Crushy Social Inc.</span>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .holding {
    --ink: rgb(35 21 61);
    --ground: rgb(250 248 252);
    --muted: rgb(108 98 126);
    --rule: rgb(35 21 61 / 0.14);
    --accent: rgb(203 7 150);
    --bloom: rgb(125 33 229 / 0.07);

    position: relative;
    min-height: 100svh;
    background-color: var(--ground);
    color: var(--ink);
    overflow: hidden;
  }

  :global(.dark) .holding {
    --ink: rgb(240 236 246);
    --ground: rgb(21 8 34);
    --muted: rgb(178 168 194);
    --rule: rgb(240 236 246 / 0.16);
    --accent: rgb(240 116 205);
    --bloom: rgb(194 46 240 / 0.14);
  }

  /* Ambient ground — a single soft bloom rising behind the statement. */
  .holding::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto -25%;
    height: 120%;
    background: radial-gradient(58% 52% at 22% 34%, var(--bloom), transparent 68%);
    pointer-events: none;
  }

  .shell {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 6vw, 6rem);
  }

  .rail {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    font-size: 0.875rem;
  }

  .wordmark {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .place {
    color: var(--muted);
  }

  .stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(3.5rem, 12vw, 8rem);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }

  .tick {
    width: 1.75rem;
    height: 1px;
    background-color: currentColor;
  }

  .statement {
    margin: 0;
    font-size: clamp(2.75rem, 8.5vw, 5.5rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .lede {
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    max-width: 42ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .handoff {
    display: block;
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease;
  }

  .handoff-text {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .handoff-label {
    font-size: 0.875rem;
    color: var(--muted);
    transition: color 200ms ease;
  }

  .handoff-action {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    transition: color 200ms ease;
  }

  .arrow {
    width: 0.9em;
    height: 0.9em;
    flex: none;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .handoff:hover {
    border-top-color: var(--accent);
  }

  .handoff:hover .handoff-action {
    color: var(--accent);
  }

  .handoff:hover .handoff-label {
    color: var(--ink);
  }

  .handoff:hover .arrow {
    transform: translateX(0.4em);
  }

  .handoff:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 2px;
  }

  .foot {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* One authored moment: the page settles into place on load. */
  @keyframes holding-rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
      filter: blur(7px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  .reveal {
    animation: holding-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0ms) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }

    .arrow {
      transition: none;
    }
  }
</style>
